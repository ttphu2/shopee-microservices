{
  "name": "client-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "typecheck": "tsc --noEmit",
    "gen:openapi": "cd ../ShopeeMicroservices && dotnet tool restore && dotnet build Services/ProductCatalog/ProductCatalog.API/ProductCatalog.API.csproj && dotnet swagger tofile --output ../client-app/openapi/bff.json Services/ProductCatalog/ProductCatalog.API/bin/Debug/net10.0/ProductCatalog.API.dll v1",
    "gen:api": "openapi-typescript ./openapi/bff.json -o src/shared/api/generated/schema.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.2",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "next": "16.4.0",
    "next-intl": "link:/next-intl",
    "nuqs": "^2.10.2",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-aria-components": "link:/react-aria-components",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "openapi-typescript": "^7.13.0",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.11.2"
}
